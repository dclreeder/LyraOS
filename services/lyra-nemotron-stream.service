[Unit]
Description=Lyra Nemotron 3.5 streaming ASR sidecar (RTC mode; parakeet.cpp C API)
After=network.target

[Service]
WorkingDirectory=/home/dclreeder/Documents/LyraOS/modules/streamstt
Environment=PARAKEET_DEVICE=Vulkan0
ExecStart=/home/dclreeder/Documents/LyraOS/modules/streamstt/build/nemotron-stream-server
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
