[Unit]
Description=Lyra STT Wyoming bridge to whisper.cpp (Fedora)
After=network.target lyra-whisper.service
Wants=lyra-whisper.service

[Service]
ExecStart=/home/dclreeder/Documents/LyraOS/modules/wyoming/venv/bin/python /home/dclreeder/Documents/LyraOS/modules/wyoming/stt_server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
