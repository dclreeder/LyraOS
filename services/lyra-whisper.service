[Unit]
Description=Lyra local STT (whisper.cpp large-v3-turbo) for the gadget
After=network.target

[Service]
Environment=LD_LIBRARY_PATH=/home/dclreeder/Documents/LyraOS/modules/whisper/build/bin
ExecStart=/home/dclreeder/Documents/LyraOS/modules/whisper/build/bin/whisper-server -m /home/dclreeder/Documents/LyraOS/modules/whisper/models/ggml-large-v3-turbo.bin --host 127.0.0.1 --port 8093 -t 8
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
