[Unit]
Description=Lyra core — Fedora-native voice controller for the Lyra Flex speaker box
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/dclreeder/Documents/LyraOS/core
Environment=PYTHONPATH=/home/dclreeder/Documents/LyraOS/core
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/dclreeder/Documents/esphome-probe/venv/bin/python -m lyra_core.production_main
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
