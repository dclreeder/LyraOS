#!/bin/bash
# llm-ctl - control the shared local LLM module (lyra-llm.service).
# Usage: llm-ctl start|stop|restart|status|test
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"
case "$1" in
  start)   systemctl --user start lyra-llm.service ;;
  stop)    systemctl --user stop lyra-llm.service ;;
  restart) systemctl --user restart lyra-llm.service ;;
  status)  systemctl --user --no-pager status lyra-llm.service | head -12 ;;
  test)
    curl -s http://127.0.0.1:8094/health && echo
    curl -s http://127.0.0.1:8094/v1/chat/completions -H 'Content-Type: application/json' -d '{"model":"lyra-llm","messages":[{"role":"user","content":"Reply with exactly: llm module ok"}],"max_tokens":16,"temperature":0}' | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d["choices"][0]["message"]["content"])'
    ;;
  *) echo "usage: llm-ctl start|stop|restart|status|test" ;;
esac
