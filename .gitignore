# LyraOS git scope: code, configs, units, docs. NOT data or secrets.
/data/
**/venv/
**/__pycache__/
**/build/
*.gguf
*.bin
*.npy
**/jobs/
**/collector_spool/
*secrets*
.env
alarm_state.json
display_state.json
tv_route_state.json
ring_state.json
mode_state.json
rtc_state.json
status_state.json
dim.json
latest.json
*.bak-*
*.wav
*.mp3
*.opus
*.flac
*.onnx.data
modules/tts/kokoro/kokoro-v1.0.onnx

# Local secrets -- never track (files stay on disk for builds/runtime)
modules/tts/kokoro/server/token.txt
*.pem
firmware/sat/esp32/devices/sdkconfig.lyra-satlink*
firmware/sat/esp32/devices/sdkconfig.lyra-satgadget

# Wake clip pool stays home (his voice + ledger); feature models are building blocks
modules/wakeword/data/clips/
!modules/wakeword/models/**/*.onnx.data

# Memory build Phase 0: conversation inbox logs are private (Daniels
# conversations) -- like the wake clip pool, they never enter the repo.
memory/inbox/
memory/notes/

# llama.cpp checkout + build artifacts (re-clone to rebuild; see modules/llm/README.md)
modules/llm/llama.cpp/
modules/llm/*.log
