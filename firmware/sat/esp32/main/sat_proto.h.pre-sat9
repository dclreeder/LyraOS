/* Provenance (sat1, 2026-10-30): copied verbatim from the archived
 * Lyra Box satellite firmware (firmware/main/sat_proto.h). The wire
 * format is the contract docs/local-path-transport.md reuses; the
 * Fedora side is fedora/sat_link.py. */
/*
 * Lyra Satellite Bridge — wire protocol.
 * Must match /home/dclreeder/Documents/LyraBridge/sat_link.py exactly:
 *
 *   frame = [magic u16 0x4C53][type u8][seq u32][t_remote_us u64][len u32][payload]
 *   big-endian, 19-byte header (Python struct ">HBIQI", no padding).
 *
 *   0x01 AUDIO_UP   640 bytes PCM16 LE mono @16kHz (20 ms), satellite -> PC
 *   0x02 AUDIO_DOWN 960 bytes PCM16 LE mono @24kHz (20 ms), PC -> satellite
 *   0x03 CTRL       JSON (hello / barge_in / set_volume / ping / pong)
 *
 * Audio payload bytes are raw little-endian int16 PCM (ESP32-S3 and x86 agree).
 * Only the 19-byte header is big-endian.
 */
#pragma once

#include <stdint.h>
#include <stddef.h>

#define SAT_MAGIC       0x4C53u
#define SAT_F_AUDIO_UP   0x01u
#define SAT_F_AUDIO_DOWN 0x02u
#define SAT_F_CTRL       0x03u

#define SAT_HEADER_LEN   19
#define SAT_MAX_PAYLOAD  65536u   /* mirrors PC's MAX_PAYLOAD */

#define SAT_UP_BYTES     640      /* 320 samples @16k */
#define SAT_UP_SAMPLES   320
#define SAT_DOWN_BYTES   960      /* 480 samples @24k */
#define SAT_DOWN_SAMPLES 480

/* Header field offsets (big-endian). */
#define SAT_OFF_MAGIC 0
#define SAT_OFF_TYPE  2
#define SAT_OFF_SEQ   3
#define SAT_OFF_TUS   7
#define SAT_OFF_LEN   15

static inline void sat_put_u16be(uint8_t *p, uint16_t v) {
    p[0] = (uint8_t)(v >> 8); p[1] = (uint8_t)v;
}
static inline void sat_put_u32be(uint8_t *p, uint32_t v) {
    p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16);
    p[2] = (uint8_t)(v >> 8);  p[3] = (uint8_t)v;
}
static inline void sat_put_u64be(uint8_t *p, uint64_t v) {
    sat_put_u32be(p, (uint32_t)(v >> 32));
    sat_put_u32be(p + 4, (uint32_t)v);
}
static inline uint16_t sat_get_u16be(const uint8_t *p) {
    return (uint16_t)(((uint16_t)p[0] << 8) | p[1]);
}
static inline uint32_t sat_get_u32be(const uint8_t *p) {
    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
           ((uint32_t)p[2] << 8) | (uint32_t)p[3];
}
static inline uint64_t sat_get_u64be(const uint8_t *p) {
    return ((uint64_t)sat_get_u32be(p) << 32) | sat_get_u32be(p + 4);
}

/* Pack one frame into out (must have SAT_HEADER_LEN + payload_len bytes). */
static inline size_t sat_pack_frame(uint8_t *out, uint8_t type, uint32_t seq,
                                    uint64_t t_us, const uint8_t *payload,
                                    uint32_t payload_len) {
    sat_put_u16be(out + SAT_OFF_MAGIC, SAT_MAGIC);
    out[SAT_OFF_TYPE] = type;
    sat_put_u32be(out + SAT_OFF_SEQ, seq);
    sat_put_u64be(out + SAT_OFF_TUS, t_us);
    sat_put_u32be(out + SAT_OFF_LEN, payload_len);
    for (uint32_t i = 0; i < payload_len; i++) out[SAT_HEADER_LEN + i] = payload[i];
    return SAT_HEADER_LEN + payload_len;
}
